{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": ["src/**", "scripts/**", "tests/**", "*.json"]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "overrides": [
    {
      "includes": ["src/providers/chatgpt-web/upstream/**"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    },
    {
      "includes": [
        "src/providers/chatgpt-web/upstream/src/adapters/chatgpt-web/gateway-session.ts"
      ],
      "formatter": { "enabled": true },
      "linter": { "enabled": true }
    }
  ],
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
